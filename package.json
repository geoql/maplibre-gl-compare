{
  "name": "@geoql/maplibre-gl-compare",
  "version": "0.0.3",
  "private": false,
  "description": "Swipe-style map comparison control for MapLibre GL JS",
  "keywords": [
    "compare",
    "gl",
    "maplibre",
    "maplibregl",
    "maps",
    "swipe"
  ],
  "homepage": "https://github.com/geoql/maplibre-gl-compare#readme",
  "bugs": {
    "url": "https://github.com/geoql/maplibre-gl-compare/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/maplibre-gl-compare.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "is-ci || husky",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "pnpm dlx jsr publish"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.5.3",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.3.0",
    "maplibre-gl": "^6.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "maplibre-gl": ">=2.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
