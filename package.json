{
  "name": "@geoql/maplibre-gl-compare",
  "version": "0.0.6",
  "private": false,
  "description": "Swipe-style map comparison control for MapLibre GL JS",
  "keywords": [
    "compare",
    "gl",
    "maplibre",
    "maplibregl",
    "maps",
    "swipe"
  ],
  "homepage": "https://maplibre-gl-compare.geoql.in",
  "bugs": {
    "url": "https://github.com/geoql/maplibre-gl-compare/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/maplibre-gl-compare.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "is-ci || husky",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "pnpm dlx jsr publish",
    "build:demo": "pnpm run build && pnpm --filter ./example run build",
    "deploy": "pnpm run build:demo && pnpm --filter ./example run deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "maplibre-gl": "^6.15.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "maplibre-gl": ">=2.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
